{
  "name": "kano-status-board",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "node scripts/run-app.mjs dev",
    "dev:client": "vite",
    "dev:server": "node scripts/run-app.mjs server",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "preview": "node scripts/run-app.mjs preview",
    "start": "node scripts/run-app.mjs start",
    "seed": "node scripts/run-app.mjs seed",
    "history:package": "node scripts/package-history-media.ts",
    "migrate:llm": "node scripts/run-app.mjs migrate-llm",
    "sync": "node scripts/run-app.mjs sync",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check-sensitive": "node scripts/check-sensitive.ts",
    "test:sensitive": "node --test scripts/check-sensitive.test.ts",
    "test:frontend": "node --test tests/*.test.ts",
    "docs:check-links": "node scripts/check-doc-links.ts",
    "check": "npm run format:check && npm run test:sensitive && npm run test:frontend && npm run check-sensitive && npm run docs:check-links && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
