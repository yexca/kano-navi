        "en": [
          [
            {
              "type": "text",
              "text": "(3) Double-sided B2 promotional poster, only for buyers of the Anime Edition at participating stores\nAnimate, Gamers, Toranoana, Sofmap,\nTSUTAYA, Tower Records, HMV, Shinseido/WonderGOO"
            }
          ]
