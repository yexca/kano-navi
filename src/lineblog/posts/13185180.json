      {
        "type": "p",
        "content": [
          {
            "type": "text",
            "text": "へちまさんとお揃いのピカチュウ！！"
          }
        ],
        "zh": [
          [
            {
              "type": "text",
              "text": "和へちまさん一人一只的同款皮卡丘！！"
            }
          ]
        ],
        "en": [
          [
            {
              "type": "text",
              "text": "A Pikachu matching Hechima's!!"
            }
          ]
        ]
      },
      {
        "type": "p",
        "content": [
          {
            "type": "text",
            "text": "怪しい光を放つゲンガーのジュース！！"
          }
        ],
        "zh": [
          [
            {
              "type": "text",
              "text": "会散发诡异光芒的耿鬼果汁！！"
            }
          ]
        ],
        "en": [
          [
            {
              "type": "text",
              "text": "A Gengar juice giving off a suspicious glow!!"
            }
          ]
        ]
      },
      {
        "type": "p",
        "content": [
          {
            "type": "image",
            "alt": "jK2jHpUE3T.jpg",
