        "type": "p",
        "content": [
          {
            "type": "text",
            "text": "テイチクさんの納会に昨日はお邪魔させていただきました！！！！"
          }
        ],
        "zh": [
          [
            {
              "type": "text",
              "text": "昨天有幸去参加了Teichiku公司的年终答谢聚会！！！！"
            }
          ]
        ],
        "en": [
          [
            {
              "type": "text",
              "text": "Yesterday I dropped in on Teichiku's year-end party!!!!"
            }
          ]
        ]
      },
      {
        "type": "p",
        "content": [
          {
            "type": "text",
            "text": "お写真を一緒に撮ってくださった、"
          }
        ],
        "zh": [
          [
            {
              "type": "text",
              "text": "和我一起合影的、"
            }
          ]
        ],
        "en": [
          [
            {
              "type": "text",
              "text": "The people who took photos with me:"
            }
          ]
        ]
      },
