        "type": "p",
        "content": [
          {
            "type": "text",
            "text": "こんばんは、鹿乃です٩( ᐛ )و"
          }
        ],
        "zh": [
          [
            {
              "type": "text",
              "text": "晚上好，我是鹿乃٩( ᐛ )و"
