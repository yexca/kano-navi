        "zh": [
          [
            {
              "type": "text",
              "text": "流感、感冒正流行，请大家千万注意保重身体、别累坏了呀！"
            }
          ]
        ],
        "en": [
          [
            {
              "type": "text",
              "text": "Please take care of yourselves and be careful not to come down with the flu or a cold!"
