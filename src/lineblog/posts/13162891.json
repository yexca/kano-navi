        "zh": [
          [
            {
              "type": "text",
              "text": "大家过得怎么样呀？"
            }
          ]
        ],
        "en": [
          [
            {
              "type": "text",
              "text": "How have you all been?"
            }
          ]
        ]
      },
      {
        "type": "p",
        "content": [
          {
            "type": "text",
            "text": "インフルエンザや風邪、体調をくれぐれも崩さないようにお体ご自愛くださいね！"
