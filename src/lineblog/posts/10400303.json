        "content": [
          {
            "type": "text",
            "text": "ではでは、お出掛けの支度してきますー！いってきまあああす！"
          }
        ],
        "zh": [
          [
            {
              "type": "text",
              "text": "那么那么，我去准备出门啦ー！出发啊啊啊啊！"
            }
          ]
        ],
        "en": [
          [
            {
              "type": "text",
              "text": "Okay then, I'm going to get ready to head out! See you laaaater!"
            }
          ]
        ]
      },
      {
        "type": "p",
        "content": [
          {
            "type": "text",
            "text": "鹿乃"
          }
        ]
      }
    ],
    "titleZh": "出发去打招呼 GO！",
    "titleEn": "Off to say hello!"
  },
