        "type": "p",
        "content": [
          {
            "type": "text",
            "text": "こんばんは、鹿乃です"
          }
        ],
        "zh": [
          [
            {
              "type": "text",
              "text": "晚上好，我是鹿乃。"
            }
          ]
        ],
        "en": [
          [
            {
              "type": "text",
              "text": "Good evening, I'm Kano"
            }
          ]
        ]
      },
      {
        "type": "p",
        "content": [
          {
            "type": "image",
