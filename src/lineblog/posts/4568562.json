            "type": "text",
            "text": "5/11 鹿乃1stアルバム「nowhere」発売決定！"
          }
        ],
        "zh": [
          [
            {
              "type": "text",
              "text": "5/11 鹿乃首张专辑《nowhere》确定发售！"
            }
          ]
        ],
        "en": [
          [
            {
              "type": "text",
              "text": "5/11: Kano's 1st album \"nowhere\" release confirmed!"
            }
          ]
        ]
      },
