        "coverSource": "https://i.ytimg.com/vi/UstE6yTlwcU/hqdefault.jpg"
      },
      {
        "type": "p",
        "content": [
          {
            "type": "link",
            "href": "http://youtu.be/UstE6yTlwcU",
            "content": [
              {
                "type": "text",
                "text": "http://youtu.be/UstE6yTlwcU"
              }
            ]
          }
        ]
      },
      {
        "type": "p",
        "content": [
          {
            "type": "text",
            "text": "ディアブレイブを引き続きよろしくー"
          }
        ],
        "zh": [
          [
            {
              "type": "text",
              "text": "《Dear Brave》也请继续多多关照哦ー"
            }
          ]
        ],
        "en": [
          [
            {
              "type": "text",
              "text": "Please keep supporting \"Dear brave\" ♪"
            }
          ]
        ]
      },
      {
        "type": "p",
