# The admin page skips login in development. Production requires a password
# with at least 12 characters.
APP_MODE=development
ADMIN_PASSWORD=
PORT=8787

# The model name may also be changed from /admin. Keep the API key in the
# runtime environment only; it is never stored in SQLite.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=30000

# Public source synchronization.
X_HANDLE=kano_2525
X_BOOTSTRAP_DAYS=7
X_DISCOVERY_LIMIT=50
X_MAX_STATUS_REQUESTS=12
X_REFRESH_KNOWN=1
YOUTUBE_CHANNEL_ID=UCShXNLMXCfstmWKH_q86B8w
YOUTUBE_BOOTSTRAP_VIDEOS=6
YOUTUBE_MAX_DETAIL_REQUESTS=12
SYNC_TIMEOUT_MS=7000
SYNC_REQUEST_DELAY_MS=150

# Media cache limits.
MEDIA_DOWNLOAD_LIMIT=20
MEDIA_DOWNLOAD_TIMEOUT_MS=10000
MEDIA_MAX_BYTES=10485760

# Set an individual flag to 1 when that synchronization stage should be skipped.
SKIP_X=0
SKIP_YOUTUBE=0
SKIP_MEDIA=0
SKIP_LLM=0
