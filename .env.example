# Production is the default. Startup requires an admin password with at least
# 12 non-padding characters. Set APP_MODE=development explicitly for local
# password-free development.
APP_MODE=production
ADMIN_PASSWORD=
# Shared frontend/API port for development, preview, and the standalone server.
PORT=7657

# Production Docker Compose pulls this published image on startup.
# Set a version tag such as 0.1.0 to pin a release, and change KANO_PORT if needed.
KANO_IMAGE=yexca/kano-navi:latest
KANO_PORT=7657

# Provider metadata and API keys are managed in /admin and stored in SQLite.
# LLM_SECRETS_KEY is the environment-only key used to encrypt provider keys.
LLM_SECRETS_KEY=
SCHEDULE_EXTRACTION_ENABLED=1
SCHEDULE_KEYWORD_ENABLED=1
SCHEDULE_VISION_ENABLED=1
SCHEDULE_MESSAGE_ENABLED=1
SCHEDULE_KEYWORDS=schedule,スケジュール,配信予定,週間予定,今週の予定,予定

# Saved workflows with a timer are started by the server process. Set to 0 to
# disable the in-process scheduler (manual runs from /admin still work).
WORKFLOW_SCHEDULER_ENABLED=1

# MCP exposes public read-only tools by default. Control tools require this
# bearer token and never accept the admin session cookie.
MCP_ENABLED=1
MCP_CONTROL_TOKEN=

# Public source synchronization.
X_HANDLES=kano_2525,_Kanotic
# X_HANDLE remains supported as a single-account compatibility fallback.
X_HANDLE=
# Optional official API credentials for paginated historical/range searches.
# Keep them in the environment; never enter them in a URL or commit this file's copy.
# X requires full-archive search access. Without keys, recent runs use the
# limited public profile/RSS; historical controls remain unavailable.
X_API_BEARER_TOKEN=
YOUTUBE_API_KEY=
# Per-source/account page cap for official history fetches (1-20).
# X also honors the shared X_MAX_STATUS_REQUESTS request cap.
SOURCE_HISTORY_MAX_PAGES=4
X_BOOTSTRAP_DAYS=7
X_DISCOVERY_LIMIT=50
X_MAX_STATUS_REQUESTS=12
X_REFRESH_KNOWN=1
# Missing schedule media gets a small, separate priority refresh budget.
X_SCHEDULE_REFRESH_LIMIT=1
YOUTUBE_CHANNEL_ID=UCShXNLMXCfstmWKH_q86B8w
YOUTUBE_BOOTSTRAP_VIDEOS=6
YOUTUBE_MAX_DETAIL_REQUESTS=12
SYNC_TIMEOUT_MS=7000
SYNC_REQUEST_DELAY_MS=150

# Media cache limits.
MEDIA_DOWNLOAD_LIMIT=20
MEDIA_DOWNLOAD_TIMEOUT_MS=10000
MEDIA_MAX_BYTES=10485760

# Set an individual flag to 1 when that synchronization stage should be skipped.
SKIP_X=0
SKIP_YOUTUBE=0
SKIP_MEDIA=0
SKIP_LLM=0
