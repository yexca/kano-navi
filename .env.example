# Production is the default. Startup requires an admin password with at least
# 12 non-padding characters. Set APP_MODE=development explicitly for local
# password-free development.
APP_MODE=production
ADMIN_PASSWORD=
# Optional explicit origin accepted for admin mutations. Leave empty to use
# the request's own origin.
ADMIN_ORIGIN=
# Optional public origin of the site, such as https://kano.example.invalid. The
# server writes it into index.html's link-preview tags, which need absolute
# URLs, and into the Atom feed's site and self links. Leave empty to keep
# them relative and the feed without a self link.
PUBLIC_ORIGIN=
# Shared frontend/API port for development, preview, and production.
PORT=7657
# Development only: loopback port of the Go backend that Vite proxies to.
KANO_API_PORT=7658
# Development only: 1 makes Vite poll for file changes, for a checkout mounted
# into a container. docker-compose.dev.yml sets it.
KANO_WATCH_POLLING=0

# Production Docker Compose pulls this published image on startup.
# Set a version tag such as 0.4.3 to pin a release, and change KANO_PORT if needed.
KANO_IMAGE=yexca/kano-navi:latest
KANO_PORT=7657

# Provider metadata and API keys are managed in /admin and stored in SQLite.
# LLM_SECRETS_KEY is the environment-only key used to encrypt provider keys.
# Required at startup in every mode, including development. Use a random key
# and preserve it across restarts to keep stored provider keys readable.
LLM_SECRETS_KEY=
SCHEDULE_EXTRACTION_ENABLED=1
SCHEDULE_KEYWORD_ENABLED=1
SCHEDULE_VISION_ENABLED=1
SCHEDULE_MESSAGE_ENABLED=1
# 1 sends every X post with text or images through the message route instead
# of only the posts the local date/stream heuristic selects.
SCHEDULE_MESSAGE_ALL_POSTS=0
SCHEDULE_KEYWORDS=schedule,スケジュール,配信予定,週間予定,今週の予定,予定

# Source timers (set per source in /admin -> Sources) and the YouTube
# live-status probe are started by the server process. Set to 0 to stop them
# (manual runs from /admin, including each source's Run now, still work).
WORKFLOW_SCHEDULER_ENABLED=1

# MCP exposes public read-only tools by default. Control tools require this
# bearer token and never accept the admin session cookie.
MCP_ENABLED=1
MCP_CONTROL_TOKEN=

# Public source synchronization.
X_HANDLES=kano_2525,_Kanotic
# Optional official API credentials. Keep them in the environment; never enter
# them in a URL or commit this file's copy. The X token enables the manual X API
# fetch method (full-archive search access: newest posts, date ranges and
# backfills) and the X timer's api chain method, a fallback the operator turns
# on in /admin behind a failure gate and a daily post cap; without it, X reads
# the public FxTwitter timeline. Without the YouTube key, the recent step and
# manual fetches use the RSS feed (15 uploads). With it, they page the uploads
# playlist (one quota unit per 50), and the recent step reads details through
# the Data API first, falling back to the public pages; the YouTube timer's
# chain can turn the Data API off without removing the key.
X_API_BEARER_TOKEN=
YOUTUBE_API_KEY=
# Read limits (request budgets, manual fetch pages, timeouts and translation
# limits) are settings in /admin, on the Sources and LLM pages. Startup stores
# X_MAX_STATUS_REQUESTS, X_REFRESH_KNOWN, X_BOOTSTRAP_DAYS, X_DISCOVERY_LIMIT,
# YOUTUBE_MAX_DETAIL_REQUESTS, SOURCE_HISTORY_MAX_PAGES, SYNC_TIMEOUT_MS,
# SYNC_REQUEST_DELAY_MS, TRANSLATION_SCAN_LIMIT and TRANSLATION_LOOKBACK_DAYS,
# when set, into a setting that has no stored value yet; leave them unset.
YOUTUBE_CHANNEL_ID=UCShXNLMXCfstmWKH_q86B8w
# yt-dlp is bundled at this path in the production image. Set empty to disable
# the method, or use `yt-dlp`/another absolute path for a host installation.
YTDLP_BINARY=/app/yt-dlp
# Bilibili account whose uploads are read (numeric mid), and the minimum minutes
# between list reads (60-1440), which is also the shortest Bilibili timer.
BILIBILI_UID=316381099
BILIBILI_MIN_INTERVAL_MINUTES=180
# Optional Bilibili login cookie (the SESSDATA value of a signed-in browser).
# Anonymous reads often meet Bilibili's captcha; signed-in reads rarely do. It
# is that account's credential: keep it in the environment, prefer a secondary
# account, and replace it when it expires or the account signs out.
BILIBILI_SESSDATA=

# Set an individual flag to 1 when that synchronization stage should be skipped.
# A skipped source's timer does not run either.
SKIP_X=0
SKIP_YOUTUBE=0
SKIP_BILIBILI=0
SKIP_MEDIA=0
SKIP_LLM=0
